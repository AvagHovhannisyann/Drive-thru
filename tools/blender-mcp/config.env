# Blender MCP service configuration.
# Sourced by every script in this directory (via lib.sh). Plain bash, no side effects.
# Every value can be overridden from the environment, e.g.  BMCP_PORT=9877 ./start.sh
#
# These pins are the single source of truth for what gets installed. To upgrade,
# change the version AND its hash here, then run:  ./install.sh && ./restart.sh

# --- Blender: official build from download.blender.org ------------------------
: "${BMCP_BLENDER_VERSION:=4.5.16}"
# SHA-256 of blender-<version>-linux-x64.tar.xz, copied from the official
# https://download.blender.org/release/Blender4.5/blender-<version>.sha256
# Set to "official" to fetch that checksum file at install time instead.
: "${BMCP_BLENDER_SHA256:=23432b064977908beb1ab4b7f32f024e7331105c875c187dce002aff84b10c11}"
# Parent directory of the extracted build (same convention as the earlier
# /opt/blender-dl/blender-4.5.9-linux-x64 setup used by design/3d/render_*.sh).
: "${BMCP_BLENDER_ROOT:=/opt/blender-dl}"

# --- MCP server + Blender add-on (PyPI: mcp-for-blender; upstream ahujasid/blender-mcp)
: "${BMCP_MCP_PACKAGE:=mcp-for-blender}"
: "${BMCP_MCP_VERSION:=2.2.7}"
# SHA-256 of the add-on bundled in that wheel (blender_mcp/bundled/addon.py).
# install.sh refuses to continue if the installed add-on differs. Empty = skip check.
: "${BMCP_ADDON_SHA256:=a7b3873aed8405bd2785292ab9b916a4392129f82a02a336b62ac14aa121828b}"
# File name the upstream installer gives the add-on (blender_mcp.py) = its module name.
: "${BMCP_ADDON_MODULE:=blender_mcp}"
# Absolute path to uvx, so MCP clients that do not inherit a login PATH still find it.
: "${BMCP_UVX:=/root/.local/bin/uvx}"
# Name and scope of the server entry registered with Claude Code.
: "${BMCP_MCP_NAME:=blender}"
# "project" keeps the entry in the repository's .mcp.json, which Claude Code cloud
# sessions load automatically at session start (commit the file when it changes).
# "local" / "user" write to ~/.claude.json on this machine only.
: "${BMCP_CLAUDE_SCOPE:=project}"

# --- Runtime ------------------------------------------------------------------
# Everything the service writes lives here: logs/, run/, userdata/, tmp/, test-output/
: "${BMCP_HOME:=/opt/blender-mcp}"
# Virtual X display and its screen (WIDTHxHEIGHTxDEPTH).
: "${BMCP_DISPLAY:=:99}"
: "${BMCP_SCREEN:=1920x1080x24}"
# Add-on socket. Must stay on loopback: the add-on executes arbitrary Python.
: "${BMCP_HOST:=127.0.0.1}"
: "${BMCP_PORT:=9876}"
# Render engine forced on the unsaved default scene when no GPU is present
# (EEVEE runs on llvmpipe here, ~20x slower than Cycles on CPU). "KEEP" = leave as is.
: "${BMCP_DEFAULT_ENGINE:=CYCLES}"
# Seconds between add-on/socket health checks inside Blender.
: "${BMCP_WATCHDOG_INTERVAL:=5}"
# Seconds between the supervisor's checks that the X display is still alive.
: "${BMCP_DISPLAY_CHECK_INTERVAL:=10}"
# Crash-loop guard: give up after this many restarts inside the window (seconds).
: "${BMCP_MAX_RESTARTS:=5}"
: "${BMCP_RESTART_WINDOW:=300}"
